# ── Game Agent — API Keys ──────────────────────────────────────────────────────
# Copy this file to .env and fill in the key(s) for the provider(s) you want to use.
# You only need ONE key — whichever provider you select in the UI.
# Never commit .env to version control.

# Anthropic (Claude) — console.anthropic.com
VITE_ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI (GPT-4o) — platform.openai.com  ($5 free credit on signup)
VITE_OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini — aistudio.google.com  (FREE tier: 1500 requests/day)
VITE_GEMINI_API_KEY=your-gemini-key-here

# Ollama — runs locally, no key needed
# Just install Ollama from ollama.com and run: ollama pull llava
