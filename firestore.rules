rules_version = '2';

// Security rules for Nexus Grid online multiplayer.
//
// v1 is built for friendly play with friends/testers and uses no sign-in, so
// these rules allow anyone to read/write room documents. That is fine for
// casual matches but is NOT cheat-proof: a malicious client could overwrite a
// room. For a hardened setup, add Firebase Anonymous Auth and validate that the
// writer is one of the room's two players (see the commented block below).

service cloud.firestore {
  match /databases/{database}/documents {
    match /rooms/{code} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Hardened alternative (requires enabling Anonymous Auth and writing
    // request.auth.uid into host/guest instead of a localStorage id):
    //
    // match /rooms/{code} {
    //   allow read: if request.auth != null;
    //   allow create: if request.auth != null
    //     && request.resource.data.host == request.auth.uid;
    //   allow update: if request.auth != null
    //     && (resource.data.host == request.auth.uid
    //         || resource.data.guest == request.auth.uid
    //         || resource.data.guest == null);
    //   allow delete: if false;
    // }
  }
}
