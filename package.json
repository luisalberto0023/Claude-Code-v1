    "check:render": "node tools/check-render.mjs",
    "check:agent": "node tools/check-agent.mjs",
    "check:episodes": "node tools/check-episodes.mjs",
    "check:snapshots": "node tools/check-snapshots.mjs",
    "check:llm": "node tools/check-llm.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "check:site-policy": "node tools/check-site-policy.mjs",
    "check:backend": "node tools/check-backend.mjs",
    "check:plugins": "node tools/check-plugins.mjs",
    "check:minesweeper": "node tools/check-minesweeper.mjs",
    "check:bench": "node tools/check-bench.mjs",
    "sim:minesweeper": "node tools/minesweeper-sim.mjs",
    "episodes": "node tools/episodes.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "vite": "^5.4.12"
  }
